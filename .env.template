# ========================================
# VoxCart - Environment Configuration Template
# ========================================
# 
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env in the same directory
# 2. Replace all placeholder values with your actual credentials
# 3. Never commit the .env file to version control
#
# ========================================

# ========================================
# SECURITY KEYS (REQUIRED)
# ========================================
# Generate secure random keys using:
# python -c "import secrets; print(secrets.token_urlsafe(32))"

SESSION_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_KEY_32_CHARS_MIN
AUTHENTICATION_KEY=REPLACE_WITH_ANOTHER_RANDOM_SECRET_KEY_32_CHARS_MIN

# ========================================
# DATABASE CONFIGURATION (REQUIRED)
# ========================================
DB_NAME=your_database_name
DB_USER=your_database_username
DB_PASSWORD=your_secure_database_password
DB_HOST=your_database_host
DB_PORT=your_database_port

# ========================================
# OPENAI API CONFIGURATION (REQUIRED)
# ========================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_OPENAI_API_KEY

# ========================================
# LANGSMITH CONFIGURATION (OPTIONAL)
# ========================================
# For LangChain debugging and monitoring
# Get your keys from: https://smith.langchain.com/settings
# Leave empty if not using LangSmith
LANGSMITH_API_KEY=
LANGSMITH_API_KEY_2=

# ========================================
# APPLICATION CONFIGURATION
# ========================================
# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://your-frontend-url:port,http://another-allowed-origin:port

# Logging configuration
LOG_LEVEL=INFO
LOG_FILENAME=your_log_filename.log

# Knowledge base file path
KB_OUTPUT_FILE=your_knowledge_base_file.json

# Backend API URL
CHATBOT_URL=http://your-backend-url:port/chat/

# ========================================
# OPTIONAL: DEVELOPMENT SETTINGS
# ========================================
# Uncomment and modify for development/production environments

# Development logging
# LOG_LEVEL=DEBUG

# Additional origins for development (comma-separated list)
# ALLOWED_ORIGINS=http://your-frontend-url:port,http://your-dev-url:port,http://another-dev-url:port

# Alternative: Full database URL (overrides individual DB settings)
# DATABASE_URL=postgresql://user:pass@host:port/dbname

# Rate limiting (if implemented)
# RATE_LIMIT_ENABLED=true
# MAX_REQUESTS_PER_MINUTE=60

# ========================================
# SECURITY BEST PRACTICES
# ========================================
# ✓ Use strong, unique passwords (16+ characters)
# ✓ Generate cryptographically secure random keys
# ✓ Never commit .env file to version control
# ✓ Rotate credentials regularly (every 90 days)
# ✓ Use different credentials for dev/staging/production
# ✓ Revoke and regenerate keys if exposed
# ✓ Use environment-specific .env files
# ✓ Consider using secrets management (AWS Secrets Manager, etc.)
#
# ========================================